# Configuración de Producción — VoxPDF Studio
APP_ENV=production
MAX_PDF_SIZE_MB=20
MAX_PDF_PAGES=1000
RATE_LIMIT_PARSE_PER_MIN=15
RATE_LIMIT_TTS_PER_MIN=90
TTS_CACHE_MAX_FILES=200
TTS_CACHE_MAX_SIZE_MB=300
ALLOWED_ORIGINS=capacitor://localhost,http://localhost,http://127.0.0.1:8000,https://edgar-lt.github.io

# IPs/CIDR de proxies de confianza para X-Forwarded-For (uvicorn). Nunca usar '*' en producción:
# con '*' cualquier cliente puede falsear su IP y evadir el rate limit.
FORWARDED_ALLOW_IPS=127.0.0.1
